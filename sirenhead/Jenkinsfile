pipeline {
    agent { label 'lnxbld1' }

    parameters {
        string(name: 'REPO_URL', defaultValue: 'https://github.com/twilliams1832/minecraft-plugins.git', description: 'Git repository URL')
        string(name: 'BRANCH', defaultValue: 'main', description: 'Git branch to build')
        string(name: 'CIFS_SERVER', defaultValue: 'naspi', description: 'CIFS server hostname or IP')
        string(name: 'CIFS_SHARE', defaultValue: 'walle', description: 'CIFS share name')
        string(name: 'ARTIFACT_PATH', defaultValue: '/mnt/share/walle/artifacts', description: 'Mount point for artifact output')
    }

    environment {
        DOCKER_IMAGE = 'registry.home/openjdk-maven:17'
        MOUNT_PATH = '/mnt/artifacts'
        JAR_NAME = 'SirenHeadPlugin.jar'
    }

    stages {
        stage('Checkout') {
            steps {
                git url: "${params.REPO_URL}", branch: "${params.BRANCH}", credentialsId: 'git-credentials'
            }
        }

        stage('Build in Docker') {
            steps {
                script {
                    def tempWorkspace = "/tmp/sirenhead-${env.BUILD_ID}"
                    docker.withRegistry('https://registry.home', 'docker-registry-credentials') {
                        docker.image(env.DOCKER_IMAGE).inside("--mount type=bind,source=${params.ARTIFACT_PATH},target=${env.MOUNT_PATH}") {
                            sh """
                                echo "🚧 Creating temp workspace at ${tempWorkspace}..."
                                mkdir -p ${tempWorkspace}
                                cp -r * ${tempWorkspace}
                                cd ${tempWorkspace}/sirenhead
                                mvn clean package
                                ls /mnt
                                stat /mnt/artifacts
                                echo "cp target/*.jar ${env.MOUNT_PATH}/${env.JAR_NAME}"
                                echo "🧹 Cleaning up temp workspace..."
                                rm -rf ${tempWorkspace}
                            """
                        }
                    }
                }
            }
        }

        stage('Archive Artifact') {
            steps {
                archiveArtifacts artifacts: "${params.ARTIFACT_PATH}/${env.JAR_NAME}", fingerprint: true
            }
        }
    }

    post {
        always {
            echo "🧹 Cleaning up..."
            sh """
                if mountpoint -q ${params.ARTIFACT_PATH}; then
                    umount ${params.ARTIFACT_PATH}
                    echo "✅ Unmounted ${params.ARTIFACT_PATH}"
                else
                    echo "ℹ️ No mount to clean up"
                fi
            """
        }
        success {
            echo "✅ Build and archive complete."
        }
        failure {
            echo "❌ Build failed. Check logs for details."
        }
    }
}
