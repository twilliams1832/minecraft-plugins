pipeline {
    agent {
        docker {
            image 'your-registry/java-openjdk-maven:latest'
            args '-v $WORKSPACE:/workspace'
        }
    }

    environment {
        MAVEN_OPTS = "-Dmaven.repo.local=/workspace/.m2"
    }

    stages {
        stage('Checkout') {
            steps {
                git url: 'https://github.com/your-org/minecraft-plugin.git', branch: 'main'
            }
        }

        stage('Build') {
            steps {
                sh 'mvn clean compile'
            }
        }

        stage('Test') {
            steps {
                sh 'mvn test'
            }
        }

        stage('Archive Artifacts') {
            steps {
                archiveArtifacts artifacts: 'target/*.jar', fingerprint: true
            }
        }
    }

    post {
        always {
            junit 'target/surefire-reports/*.xml'
        }
    }
}